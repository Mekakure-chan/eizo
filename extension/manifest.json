{
  "manifest_version": 3,
  "name": "映蔵｜埋め込み動画保存",
  "version": "1.6.20",
  "description": "タブでHLSを自動検出し、ライブやアーカイブをMP4に保存します。動画ファイルの取得と再生区間のキャプチャにも対応します。",
  "minimum_chrome_version": "109",
  "incognito": "split",
  "permissions": ["activeTab", "scripting", "webNavigation", "webRequest", "storage", "offscreen", "downloads"],
  "optional_permissions": ["nativeMessaging"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "映蔵｜埋め込み動画保存\n埋め込み動画を探す",
    "default_popup": "popup.html"
  }
}
